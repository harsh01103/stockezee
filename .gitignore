# ==========================================
# Git Ignore Rules for Options Quant Platform
# ==========================================

# 1. High-Frequency & Large Tick Datasets (3.35 GB / 58k files)
OPTIONS/data/
data/raw/
*.parquet
*.parquet.*

# 2. Dependencies & Package Managers
node_modules/
*/node_modules/
*/*/node_modules/

# 3. Security, Keys, Tokens & Sensitive Environments
.env
*.env
.env.*
!.env.example
!*/.env.example
!*/*/.env.example
*.pem
*.key
*.token
*.enc
*token*.json
upstox_token.json
token.enc
token_meta.json

# 4. Python Build, Cache & Virtual Environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.mypy_cache/
*/.mypy_cache/
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
*.egg-info/
*.egg
build/
dist/

# 5. R Workspace & History
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# 6. Web Application Build Artifacts
dist/
build/
.next/
out/
.vercel/

# 7. Submodule Backups & System Files
.git_submodule_backup/
*/.git_submodule_backup/
.DS_Store
Thumbs.db
desktop.ini

# 8. Run Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
